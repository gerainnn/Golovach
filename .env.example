# ============================================================
# Golovach — пример конфигурации
# Скопируй в .env и заполни. Или используй: python configure.py
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Роли → "provider_name/model_name" ---
# Формат: имя_провайдера/имя_модели (как в providers.json)
# Пример: groq/llama-3.3-70b-versatile
CLASSIFIER_MODEL=
ORCHESTRATOR_MODEL=
CODER_A_MODEL=
CODER_B_MODEL=
CRITIC_MODEL=
JUDGE_MODEL=

# --- Параметры (дублируют settings.json для совместимости) ---
DEBATE_ROUNDS=1
REQUEST_TIMEOUT=120

# --- Админы /settings (Telegram user IDs через запятую, пусто = все) ---
ADMIN_IDS=
