# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Provider 1: Kiro (primary) ---
# Подставь реальный base_url и ключ от Kiro
KIRO_API_KEY=
KIRO_BASE_URL=https://api.kiro.example/v1

# --- Provider 2: free API (fallback) ---
# Напр. Groq (https://api.groq.com/openai/v1), Z.AI, Cerebras, Together и т.п.
FREE_API_KEY=
FREE_BASE_URL=

# --- Модели по ролям ---
# Формат имени — как у твоего провайдера (напр. "anthropic/claude-sonnet-4" в Kiro/OpenRouter-подобных)
CLASSIFIER_MODEL=openai/gpt-4o-mini
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4.5
# Важно: Coder A и Coder B лучше держать РАЗНЫМИ семействами — иначе дебат бессмыслен
CODER_A_MODEL=anthropic/claude-sonnet-4.5
CODER_B_MODEL=openai/gpt-5
CRITIC_MODEL=deepseek/deepseek-v3.2
JUDGE_MODEL=openai/gpt-5

# Модели на запасном провайдере (должны существовать у free-провайдера)
FREE_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Пайплайн ---
DEBATE_ROUNDS=1
REQUEST_TIMEOUT=120

# --- Админы /settings (через запятую). Пусто = любой чат может менять ---
ADMIN_IDS=
